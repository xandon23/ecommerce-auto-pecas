</head>
<body class="bg-light">
<div class="container my-5">
    <h2 class="mb-4"><i class="bi bi-bag-check"></i> Meus Pedidos</h2>

    <?php if (empty($pedidos)): ?>
        <div class="alert alert-info">
            Você ainda não fez nenhuma compra. <a href="<?= BASE_URL ?>/home">Ir para a loja</a>.
        </div>
    <?php else: ?>
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th># Pedido</th>
                                <th>Data</th>
                                <th>Status</th>
                                <th>Total</th>
                                <th>Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php foreach ($pedidos as $p): ?>
                            <tr>
                                <td><strong>#<?= $p->id_pedido ?></strong></td>
                                <td><?= date('d/m/Y H:i', strtotime($p->data_pedido)) ?></td>
                                <td>
                                    <?php 
                                        $cor = 'bg-secondary';
                                        if($p->status == 'Confirmado') $cor = 'bg-success';
                                        if($p->status == 'Pendente') $cor = 'bg-warning text-dark';
                                        if($p->status == 'Cancelado') $cor = 'bg-danger';
                                    ?>
                                    <span class="badge <?= $cor ?>"><?= $p->status ?></span>
                                </td>
                                <td>R$ <?= number_format($p->valor_total, 2, ',', '.') ?></td>
                                <td>
                                    <a href="<?= BASE_URL ?>/pedido/detalhes/<?= $p->id_pedido ?>" class="btn btn-sm btn-outline-primary">
                                        Ver Itens
                                    </a>
                                </td>
                            </tr>
                            <?php endforeach; ?>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    <?php endif; ?>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
