<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><?= $titulo ?? 'Login' ?></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="<?= BASE_URL ?>/css/style.css">
    <style>
        body { background-color: #f0f2f5; }
        .simple-header {
            background-color: var(--main-color);
            padding: 20px 0;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            margin-bottom: 50px;
        }
    </style>
</head>
<body>

    <div class="simple-header text-center">
        <a href="<?= BASE_URL ?>/home">
            <img src="<?= BASE_URL ?>/img/logodino.png" alt="Autopeças Dino" style="height: 70px;">
        </a>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card shadow border-0 rounded-3">
                    <div class="card-body p-4 p-md-5">
                        <h3 class="text-center fw-bold mb-4 text-dark">Login</h3>
                        
                        <form action="<?= BASE_URL ?>/index/verificar" method="post">
                            <div class="mb-3">
                                <label for="email" class="form-label text-muted small fw-bold">E-MAIL</label>
                                <input type="email" name="email" id="email" class="form-control form-control-lg bg-light" required>
                            </div>
                            
                            <div class="mb-4">
                                <label for="senha" class="form-label text-muted small fw-bold">SENHA</label>
                                <div class="input-group">
                                    <input type="password" name="senha" id="senha" class="form-control form-control-lg bg-light" required>
                                    <button type="button" class="btn btn-outline-secondary" onclick="toggleSenha('senha', 'icon_login')">
                                        <i class="bi bi-eye" id="icon_login"></i>
                                    </button>
                                </div>
                            </div>
                            
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-brand btn-lg shadow-sm">ENTRAR</button>
                            </div>
                        </form>
                        
                        <hr class="my-4">
                        <div class="text-center">
                            <p class="text-muted mb-2">Novo por aqui?</p>
                            <a href="<?= BASE_URL ?>/index/cadastro" class="btn btn-outline-dark w-100">Criar uma conta</a>
                        </div>
                        <div class="text-center mt-4">
                            <a href="<?= BASE_URL ?>/home" class="text-decoration-none small text-muted"><i class="bi bi-arrow-left"></i> Voltar para a loja</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function toggleSenha(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.replace("bi-eye-slash", "bi-eye");
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>